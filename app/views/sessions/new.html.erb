<% content_for :title, "DiceChess — Вход" %>
<% content_for :main_class, "container-narrow" %>

<section class="card">
  <h1 class="card-title">Вход в DiceChess</h1>

  <%= form_with url: login_path do |form| %>
    <div class="field">
      <%= form.label :username, "Никнейм", class: "label" %>
      <%= form.text_field :username, value: params[:username], class: "input", required: true, autofocus: true, autocomplete: "username" %>
    </div>

    <div class="field">
      <%= form.label :password, "Пароль", class: "label" %>
      <%= form.password_field :password, class: "input", required: true, autocomplete: "current-password" %>
    </div>

    <%= form.submit "Войти", class: "btn btn-primary btn-block" %>
  <% end %>

  <p class="card-footer">Впервые тут? <%= link_to "Зарегистрироваться", register_path %></p>
</section>
