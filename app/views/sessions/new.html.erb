<% content_for :title, "DiceChess — Вход" %>

<h1>Вход в DiceChess</h1>

<%= form_with url: login_path do |form| %>
  <p>
    <%= form.label :username, "Никнейм" %><br>
    <%= form.text_field :username, value: params[:username], required: true, autofocus: true, autocomplete: "username" %>
  </p>
  <p>
    <%= form.label :password, "Пароль" %><br>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  </p>
  <p><%= form.submit "Войти" %></p>
<% end %>

<hr>
<p>Впервые тут? <%= link_to "Зарегистрироваться", register_path %></p>
