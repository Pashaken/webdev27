<% content_for :title, "DiceChess — Регистрация" %>
<% content_for :main_class, "container-narrow" %>

<section class="card">
  <h1 class="card-title">Регистрация в DiceChess</h1>

  <% if @user.errors.any? %>
    <div class="alert alert-error">
      <p class="alert-title">Не удалось зарегистрироваться:</p>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: register_path do |form| %>
    <div class="field">
      <%= form.label :username, "Никнейм", class: "label" %>
      <%= form.text_field :username, class: "input", required: true, minlength: 3, maxlength: 50, autofocus: true, autocomplete: "username" %>
    </div>

    <div class="field">
      <%= form.label :password, "Пароль (минимум 6 символов)", class: "label" %>
      <%= form.password_field :password, class: "input", required: true, minlength: 6, autocomplete: "new-password" %>
    </div>

    <%= form.submit "Создать аккаунт", class: "btn btn-primary btn-block" %>
  <% end %>

  <p class="card-footer">Уже зарегистрированы? <%= link_to "Войти", login_path %></p>
</section>
