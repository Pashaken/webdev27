<% action_class = "btn btn-primary btn-sm" %>

<article class="game-card">
  <div class="game-card-players">
    <% [ [ "w", white ], [ "b", black ] ].each do |color, (name, rating, url)| %>
      <div class="game-card-player">
        <%= tag.span class: "piece-icon", data: { piece: "#{color}k" }, aria: { label: color == "w" ? "Белые" : "Чёрные" } %>
        <% if name %>
          <span class="avatar avatar-sm"><%= name.first.upcase %></span>
          <span><%= url ? link_to(name, url, class: "player-link") : name %></span>
          <span class="muted"><%= rating %></span>
        <% else %>
          <span class="muted">Свободно</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="game-card-meta">
    <span class="badge"><%= control %></span>
    <span class="badge badge-accent">Два кубика</span>
    <% if local_assigns[:badge] %>
      <span class="badge"><%= badge %></span>
    <% end %>
  </div>

  <% if local_assigns[:url] && local_assigns[:http_method] == :post %>
    <%= button_to action, url, class: action_class %>
  <% elsif local_assigns[:url] %>
    <%= link_to action, url, class: action_class %>
  <% else %>
    <%= tag.button action, type: "button", class: action_class %>
  <% end %>
</article>
