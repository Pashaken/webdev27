<article class="game-card">
  <div class="game-card-players">
    <% [ [ "w", white ], [ "b", black ] ].each do |color, (name, rating)| %>
      <div class="game-card-player">
        <%= tag.span class: "piece-icon", data: { piece: "#{color}k" }, aria: { label: color == "w" ? "Белые" : "Чёрные" } %>
        <span class="avatar avatar-sm"><%= name.first.upcase %></span>
        <span><%= name %></span>
        <span class="muted"><%= rating %></span>
      </div>
    <% end %>
  </div>

  <div class="game-card-meta">
    <span class="badge"><%= control %></span>
    <span class="badge badge-accent">Два кубика</span>
  </div>

  <%= tag.button action, type: "button", class: "btn btn-primary btn-sm" %>
</article>
