<% state = local_assigns[:state] %>
<% die_class = [ "die", ("is-#{state}" if state) ] %>

<div class="die-slot">
  <% if local_assigns[:url] %>
    <%= button_to "", local_assigns[:url], params: { die: value }, class: die_class, form_class: "die-form",
                                           data: { value: value }, disabled: state == :blocked,
                                           aria: { pressed: state == :selected, label: "Кубик: #{value}" } %>
  <% else %>
    <%= tag.button "", type: "button",
                   class: die_class,
                   data: { value: value },
                   disabled: state == :blocked,
                   aria: { pressed: state == :selected, label: "Кубик: #{value}" } %>
  <% end %>

  <% if local_assigns[:piece] %>
    <span class="die-caption">
      <%= tag.span class: "piece-icon", data: { piece: piece } %>
      <%= piece_label(piece) %>
    </span>
  <% end %>
</div>
