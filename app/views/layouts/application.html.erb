<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "DiceChess" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
  </head>

  <body>
    <% if notice %>
      <p><%= notice %></p>
    <% end %>
    <% if alert %>
      <p><strong><%= alert %></strong></p>
    <% end %>

    <%= yield %>
  </body>
</html>
