<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "DiceChess" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <script src="<%= ui_asset("theme.js") %>"></script>
    <script src="<%= ui_asset("clock.js") %>" defer></script>
    <link rel="stylesheet" href="<%= ui_asset("tokens.css") %>">
    <link rel="stylesheet" href="<%= ui_asset("base.css") %>">
    <link rel="stylesheet" href="<%= ui_asset("components.css") %>">
    <link rel="stylesheet" href="<%= ui_asset("icons.css") %>">
    <link rel="stylesheet" href="<%= ui_asset("game.css") %>">
    <%= yield :head %>
  </head>

  <body>
    <header class="header">
      <div class="container header-inner">
        <%= link_to "DiceChess", root_path, class: "brand" %>

        <nav class="nav">
          <button class="btn btn-ghost btn-sm btn-icon" type="button" data-theme-toggle data-tooltip="Сменить тему" data-tooltip-pos="bottom" aria-label="Сменить тему">
            <span class="icon icon-contrast" aria-hidden="true"></span>
          </button>

          <% if current_user %>
            <%= link_to current_user.username, profile_path, class: "nav-link nav-user" %>
            <%= button_to "Выйти", logout_path, method: :delete, class: "btn btn-ghost btn-sm", form_class: "nav-form" %>
          <% else %>
            <%= link_to "Войти", login_path, class: "nav-link" %>
            <%= link_to "Регистрация", register_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container main <%= content_for(:main_class) %>">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-error"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
