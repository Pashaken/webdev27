<% seat = game.game_player_of(color) %>
<% left = game.clock_left(color) %>

<%= render "ui/player", name: seat&.user&.username || "Ждём соперника",
                        rating: seat ? (seat.rating_before || seat.user.rating) : "—",
                        clock: clock_text(left),
                        active: game.active? && game.turn == color,
                        low: game.active? && left < 30,
                        captured: captured_by(moves, color) %>
